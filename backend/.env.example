NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/rcm_dev?replicaSet=rcmDevRs
CLIENT_ORIGIN=http://localhost:5173
# Production session cookies are first-party through the Cloudflare Pages /api proxy.
COOKIE_SAME_SITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=RCM Administrator

# SMTP delivers existing walk-in activation codes and new customer verification links.
# Configure and test delivery before advertising customer registration in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-account@example.com
SMTP_PASS=your-provider-app-password
EMAIL_FROM=RCM Travel & Tours <your-smtp-account@example.com>

# Optional local delivery check. Uses the configured sender and sends to this recipient.
# npm run test:email -- recipient@example.com
