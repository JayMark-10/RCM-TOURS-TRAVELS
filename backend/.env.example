NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/rcm_dev?replicaSet=rcmDevRs
CLIENT_ORIGIN=http://localhost:5173
# Production session cookies are first-party through the Cloudflare Pages /api proxy.
COOKIE_SAME_SITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=RCM Administrator

# Resend HTTPS API delivers existing walk-in activation codes and new customer verification links.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=RCM Travel & Tours <verified-sender@example.com>

# Optional local delivery check. Requires a valid key and sender; sends a test message.
# npm run test:email -- recipient@example.com
